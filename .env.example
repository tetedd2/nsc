# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ถูก commit เพราะอยู่ใน .gitignore)
# คัดลอก (PowerShell):  Copy-Item .env.example .env

# OpenAI API key สำหรับ proxy.js  (ขอได้ที่ https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# พอร์ตที่ proxy จะรัน (ไม่ใส่ก็ได้ ค่าเริ่มต้น 3000)
PORT=3000

# origin ที่อนุญาตให้เรียก proxy ได้ คั่นด้วยเครื่องหมายจุลภาค
# ใส่ URL ของเว็บจริงเมื่อ deploy เช่น https://myapplication-bd04c034.web.app
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
